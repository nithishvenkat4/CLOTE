[Unit]
Description=CLOTE - Self-Hosted File Management Server
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=clote
Group=clote
WorkingDirectory=/opt/clote/server

# Load environment from file
EnvironmentFile=/opt/clote/.env

# Run uvicorn directly (no venv — install system-wide or use absolute path)
ExecStart=/opt/clote/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000

# Restart policy
Restart=on-failure
RestartSec=5s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=clote

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/clote/server/storage /opt/clote/server/logs
PrivateTmp=true

[Install]
WantedBy=multi-user.target
